{
	admin off
	servers {
		timeouts {
			read_header 5s
			read_body 10s
			write 30s
			idle 30s
		}
		max_header_size 16KB
	}
}

(upstream_transport) {
	# Only the host TLS proxy should reach this loopback-published service.
	header_up X-Forwarded-Proto https
	transport http {
		dial_timeout 3s
		response_header_timeout 10s
	}
}

http://{$PUBLIC_HOST}:8080 {
	request_body /api/* {
		max_size 32768
	}

	@esp_ingest {
		method POST
		path /api/esp/notifications
	}
	handle @esp_ingest {
		reverse_proxy app:8000 {
			import upstream_transport
		}
	}

	handle {
		reverse_proxy app:8000 {
			header_up -Authorization
			import upstream_transport
		}
	}
}
