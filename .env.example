# Copy this file to .env and set your key locally.
OPENAI_API_KEY=

# Default: hosted GPT classification and hosted speech.
CLASSIFIER_PROVIDER=openai
CLASSIFIER_MODEL=gpt-6-luna
TTS_PROVIDER=openai
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=alloy

# For explicitly labeled offline development:
# CLASSIFIER_PROVIDER=demo
# TTS_PROVIDER=macos

# Durable operation limit; not a dollar balance or provider billing setting.
MAX_PROVIDER_CALLS=5000
MAX_PENDING_NOTIFICATIONS=100
LEASE_SECONDS=90
MAX_DELIVERY_ATTEMPTS=5

# Batch classification uses at most 10 same-conversation inputs per operation.
CLASSIFICATION_BATCH_WAIT_SECONDS=0.5
GROUPING_DELAY_SECONDS=2
GROUPING_WINDOW_SECONDS=60
MAX_GROUP_NOTIFICATIONS=50

# Match the iPhone's timezone; ANCS compact dates carry no UTC offset.
ESP_TIMEZONE=America/Los_Angeles
# Set a private random token (32+ characters) before enabling external ESP ingress.
# ESP_INGEST_TOKEN=replace-with-a-private-random-token
